# Copy to .env.local and fill in.
# Get these from https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Used by the LeetCode sync job. Do NOT expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Your LeetCode username (public). Optional: a session cookie for private data.
LEETCODE_USERNAME=your-leetcode-username
LEETCODE_SESSION=

# Shared secret so only you can call the sync endpoint.
SYNC_SECRET=change-me-to-a-long-random-string
