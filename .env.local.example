# Copy to .env.local and fill in.

# ---------- Supabase ----------
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------- LeetCode (optional) ----------
# Your LeetCode username. Optional: a session cookie for private data.
LEETCODE_USERNAME=
LEETCODE_SESSION=

# ---------- Gmail auto-import (optional) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web)
# Authorized redirect URI must match: https://<your-vercel-url>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret so only you can call the sync endpoint from a cron job.
SYNC_SECRET=
