{
  "manifest_version": 3,
  "name": "Summer Tracker Job Saver",
  "version": "0.1.0",
  "description": "One-click save a job posting (LinkedIn, Indeed, company page) into your Summer Tracker.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Save job to Summer Tracker",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html"
}
